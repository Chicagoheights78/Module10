def compute_ticket_price(miles):
    if miles >= 30:
        ticket_price = 12
    elif miles >= 20:
        ticket_price = 10
    elif miles >= 10:
        ticket_price = 8
    else:
        ticket_price = 5
    return ticket_price
choice = "Yes"
total_ticket_price = 0
while choice == "Yes":
    last_name = input("Enter last name: ")
    miles = float(input("Enter miles from downtown Chicago: "))
    ticket_price = compute_ticket_price(miles)
    print()
    print("Train Ticket Information")
    print("------------------------")
    print(f"Last Name: {last_name}")
    print(f"Miles From Downtown Chicago: {miles}")
    print(f"Ticket Price: ${ticket_price:.2f}")
    print()
    total_ticket_price = total_ticket_price + ticket_price
    choice = input("Do you want to enter another passenger? (Yes or No): ")
print()
print("Ticket Summary")
print("--------------")
print(f"Total Ticket Sales: ${total_ticket_price:.2f}")