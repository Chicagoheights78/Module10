def compute_sales_price(msrp, make, model, ev_code):
    if ev_code == "Y":
        discount_percent = 0.30
    elif make == "Honda" and model == "Accord":
        discount_percent = 0.10
    elif make == "Toyota" and model == "Rav4":
        discount_percent = 0.15
    else:
        discount_percent = 0.05
    sales_price = msrp * (1 - discount_percent)
    sales_price = sales_price * 1.07

    return sales_price
choice = "Yes"
total_msrp = 0
total_sales_price = 0
while choice == "Yes":
    make = input("Enter make: ")
    model = input("Enter model: ")
    ev_code = input("Electric vehicle (Y or N): ")
    msrp = float(input("Enter MSRP: "))
    sales_price = compute_sales_price(msrp, make, model, ev_code)
    print()
    print("Vehicle Sales Information")
    print("-------------------------")
    print(f"Make: {make}")
    print(f"Model: {model}")
    print(f"MSRP: ${msrp:.2f}")
    print(f"Sales Price: ${sales_price:.2f}")
    print()
    total_msrp = total_msrp + msrp
    total_sales_price = total_sales_price + sales_price
    choice = input("Do you want to enter another vehicle? (Yes or No): ")
print()
print("Vehicle Sales Summary")
print("---------------------")
print(f"Total MSRP: ${total_msrp:.2f}")
print(f"Total Sales Price: ${total_sales_price:.2f}")